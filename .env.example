# Execute: python3 scripts/bootstrap.py
# Values below describe local defaults. Bootstrap generates all passwords in .env.
KEYCLOAK_PUBLIC_URL=http://localhost:8180
PUBLIC_WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080
TRACE_SAMPLE_RATE=1.0
# Production: change the above to https://auth.example.com, https://app.example.com, https://api.example.com
# Production Nginx virtual hosts: set in .env and run bootstrap again.
PUBLIC_API_HOST=api.example.com
PUBLIC_AUTH_HOST=auth.example.com
